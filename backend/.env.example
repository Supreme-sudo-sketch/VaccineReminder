# Settings for the backend server. Copy this file to .env (in this backend folder) and fill it in.
# npm start, npm run seed and npm run check-sms read .env automatically. Never share or commit .env:
# the keys let anyone send SMS on your account.

# --- SMS ----------------------------------------------------------------------------------------
# Fill in ONE provider. With no keys the server runs in test mode: reminders are only written to the
# sms_log table. Check the keys with: npm run check-sms   (add a phone number to send a test SMS)
#
# Which provider to use when several have keys: textbee, twilio or africastalking; "none" switches
# SMS off but keeps the keys.
SMS_PROVIDER=

# TextBee (textbee.dev). SMS go out from an Android phone running the TextBee app, through its SIM,
# at that SIM's normal SMS rate, to any number. Install the app, sign up at textbee.dev, click
# "Add device" in the dashboard and scan the QR code with the app, then copy the API key here.
# TEXTBEE_DEVICE_ID picks the phone (npm run check-sms lists their ids); leave it empty to use the
# default one. TEXTBEE_BASE_URL is only for a self-hosted TextBee server.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Twilio (twilio.com). Live credentials from the Twilio console > Account info, not the test ones.
# TWILIO_FROM is the Twilio phone number messages come from, e.g. +15551234567.
# A trial account only delivers to numbers verified in the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Africa's Talking (africastalking.com). Use AT_USERNAME=sandbox with a sandbox key to try it free;
# messages then go only to the Africa's Talking simulator.
AT_USERNAME=
AT_API_KEY=
# Optional name shown as the sender, e.g. your clinic. Africa's Talking must approve it first.
AT_SENDER_ID=

# Optional. Demo children never get real SMS anyway; children registered in the app do. Set this to
# limit real SMS to a few numbers, e.g. while testing: messages to all other numbers are only logged.
# Separate several numbers with commas, e.g. SMS_ONLY_TO=0712345678, 0722000000
SMS_ONLY_TO=

# Daily automatic reminders after 08:00 Nairobi time. Set to off so SMS only go out when a health
# worker sends them from the app (a child's record, the Follow-up list, or the dashboard button).
AUTO_REMINDERS=

# --- Database ---------------------------------------------------------------------------------
# The default vaccine.db has the demo data, whose children never get real SMS. For real use you can
# point it at a fresh database, for example:
# DB_PATH=live.db

# --- Accounts -----------------------------------------------------------------------------------
# Health workers need this code to create an account. Give it only to staff.
REGISTRATION_CODE=

# --- Vaccination evidence pictures --------------------------------------------------------------
# Caregivers' photos of vaccination cards and doctor's notes are stored encrypted in DOCUMENT_DIR
# (default: documents). The key is DOCUMENT_KEY (64 hexadecimal characters) or, when it is empty, the
# file named by DOCUMENT_KEY_FILE (default: document.key), created on first start. Back the key up with
# the database: without it the stored pictures cannot be read. Never commit either.
DOCUMENT_DIR=
DOCUMENT_KEY=
DOCUMENT_KEY_FILE=

# --- OpenStreetMap ------------------------------------------------------------------------------
# OpenStreetMap asks for a User-Agent with a contact email, e.g.
# OSM_USER_AGENT=VaccineReminderKE/2.0 (you@example.com)
